+def _clarification(
+    *,
+    query_id: str,
+    release: SemanticRelease,
+    index: SemanticIndexSnapshot,
+    trace: list[QueryTraceStep],
+    diagnostics: QueryDiagnosis,
+    question: str,
+    options: tuple[ClarificationOption, ...],
+) -> ClarificationQueryResponse:
+    """澄清响应的信封。
+
+    四处澄清出口原先各自重复同一组五个字段（query_id / release_id / spec_hash /
+    index_snapshot_id / trace），差别只在诊断、问法和选项上。把信封收在一处之后，
+    每个出口剩下的就只是它真正不同的那三样。
+    """
+
+    return ClarificationQueryResponse(
+        query_id=query_id,
+        release_id=release.id,
+        spec_hash=release.spec_hash,
+        index_snapshot_id=index.id,
+        trace=tuple(trace),
+        diagnostics=diagnostics,
+        question=question,
+        options=options,
+    )
+
