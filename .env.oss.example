# Standalone edition. Copy to .env, then: set -a; source .env; set +a
#
# Only the catalog database is configured here. The datasource you want to query
# and the chat/embedding model endpoints are set in the web UI and stored in
# $KNOWFLOW_OSS_DATA_DIR/config.json with mode 0600, so API keys never end up in
# your shell history or a compose file.

# --- required ---------------------------------------------------------------
# The service's own database, holding semantic models, revisions and releases.
# It must NOT be the database you want to query. A bare postgresql:// URL is
# upgraded to the psycopg3 driver automatically. Tables are created on start.
KNOWFLOW_OSS_CATALOG_DATABASE_URL=postgresql://analytics:analytics@127.0.0.1:5432/analytics_catalog

# --- serving ----------------------------------------------------------------
KNOWFLOW_OSS_DATA_DIR=./data
KNOWFLOW_OSS_HOST=127.0.0.1
KNOWFLOW_OSS_PORT=9395
# Built web bundle. Defaults to ./web/dist next to this package.
# KNOWFLOW_OSS_WEB_DIST=./web/dist

# --- access -----------------------------------------------------------------
# One shared password in front of the UI. Empty means no login screen; set it
# whenever the port is reachable from another machine.
KNOWFLOW_OSS_ACCESS_PASSWORD=

# --- tuning -----------------------------------------------------------------
# Parallel model calls during AI modelling. Set to 1 if your provider
# rate-limits bursts (free tiers commonly do).
KNOWFLOW_OSS_MODELING_MAX_CONCURRENCY=3
# One modelling or semantic-SQL call against a large model can exceed a minute.
KNOWFLOW_OSS_MODEL_TIMEOUT_SECONDS=120
# Opt-in follow-up question rewriting.
KNOWFLOW_OSS_MULTI_TURN_ENABLED=false
# off | shadow | auto. auto adjudicates one weak metric phrase, then falls back to HITL.
KNOWFLOW_OSS_WEAK_METRIC_ADJUDICATION_MODE=shadow
# Cross-type and multi-phrase semantic intent use an independent rollout gate.
KNOWFLOW_OSS_SEMANTIC_INTENT_ADJUDICATION_MODE=shadow
# Multi-root, no-metric business-grain adjudication has its own rollback switch.
KNOWFLOW_OSS_ANALYSIS_OBJECT_ADJUDICATION_MODE=shadow
# Explicit user choices are actor/project/release/candidate-bound and expire.
KNOWFLOW_OSS_CONFIRMATION_MEMORY_TTL_SECONDS=2592000
