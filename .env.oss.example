# 开源独立版。复制为 .env 后：set -a; source .env; set +a
#
# 只配置 catalog 库。要分析的业务库与聊天/嵌入模型端点在页面「设置」里填写，
# 保存在 $KNOWFLOW_OSS_DATA_DIR/config.json（0600），不经过 shell 与 compose。

# 服务自己的库（语义模型、版本、发布），不能是要分析的那个库。启动时自动建表。
KNOWFLOW_OSS_CATALOG_DATABASE_URL=postgresql://analytics:analytics@127.0.0.1:5432/analytics_catalog

KNOWFLOW_OSS_DATA_DIR=./data
KNOWFLOW_OSS_HOST=127.0.0.1
KNOWFLOW_OSS_PORT=9395

# 界面前的一道共享口令。空 = 不弹登录；端口对外可达时务必设置。
KNOWFLOW_OSS_ACCESS_PASSWORD=
