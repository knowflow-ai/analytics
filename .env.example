# 商业版（嵌入 RAGFlow）核心配置。其余调优项都有默认值，需要时再加。
# 服务自己的 catalog 库（语义模型、版本、发布），必须与业务数据库分开。
KNOWFLOW_ANALYTICS_CATALOG_DATABASE_URL=postgresql+psycopg://analytics:change-me@127.0.0.1:5432/analytics_catalog
# 部署配置的默认业务库（只读账号）；数据源也可在页面里逐个添加。
KNOWFLOW_ANALYTICS_DATASOURCE_DATABASE_URL=postgresql+psycopg://analytics_readonly:change-me@127.0.0.1:5432/customer_data
# RAGFlow -> analytics 的服务间密钥，至少 32 个随机字符，两边必须一致。
KNOWFLOW_ANALYTICS_SERVICE_SECRET=replace-with-a-random-service-secret
# RAGFlow 内部网关：模型与嵌入都走宿主的租户配置。token 即部署的 RAGFLOW_SECRET_KEY。
KNOWFLOW_ANALYTICS_RAGFLOW_BASE_URL=http://127.0.0.1:9380
KNOWFLOW_ANALYTICS_RAGFLOW_SERVICE_TOKEN=replace-with-ragflow-secret-key
# 启动时自动建表（目前没有版本化迁移）。
KNOWFLOW_ANALYTICS_AUTO_CREATE_SCHEMA=true
# 允许授权诊断返回物理 SQL（执行过程面板）。只认进程环境变量。
# KNOWFLOW_ANALYTICS_ALLOW_DEBUG_SQL=false
