# 本机问数服务的可调参数。复制成 local.env 后修改,该文件不进版本库。
#
# start_analytics.sh 会读这里的值;不设或留空则用括号里的默认值,
# 与线上一致。注意 AnalyticsSettings 的 env_file=None,只认进程环境
# 变量——直接改同目录的 .env 对本启动路径无效。

# 发布前黄金评测要求的最少用例数(默认 30)。
# 本机调试时调小可以快速走通发布链路。
KNOWFLOW_ANALYTICS_MINIMUM_EVALUATION_CASES=30

# 发布前黄金评测要求的准确率(默认 1.0,即 100%)。
KNOWFLOW_ANALYTICS_MINIMUM_ACCURACY=1.0

# 自洽投票次数(默认 1,即关闭)。N>1 时同一问题独立生成 N 次取多数,
# 每次重新洗牌 few-shot 样例。它只降低解码随机性带来的偶发错误,
# 压不住系统性错误,替代不了确定性护栏。
#
# 评测集与线上必须用同一个值:评测开、线上不开,会看到比线上更好的假象。
KNOWFLOW_ANALYTICS_SELF_CONSISTENCY_NUMBER=1

# weak 指标裁决模式(默认 shadow，完成影子校准后显式切 auto)：
# off=直接人工确认；shadow=AI 判断但仍人工；auto=AI 唯一判断且治理校验通过时自动继续。
KNOWFLOW_ANALYTICS_WEAK_METRIC_ADJUDICATION_MODE=shadow

# V2 跨类型与多短语语义裁决单独灰度，避免旧单指标 auto 隐式扩大权限。
KNOWFLOW_ANALYTICS_SEMANTIC_INTENT_ADJUDICATION_MODE=shadow

# 无指标锚点的多业务粒度独立灰度；auto 只采用 MATCH + Resolver SELECTED。
KNOWFLOW_ANALYTICS_ANALYSIS_OBJECT_ADJUDICATION_MODE=shadow

# 人工确认记忆 TTL（秒），默认 30 天；Release/spec/index/candidate 变化仍立即失效。
KNOWFLOW_ANALYTICS_CONFIRMATION_MEMORY_TTL_SECONDS=2592000
