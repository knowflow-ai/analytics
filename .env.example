# V0 uses PostgreSQL for the analytics catalog and the governed read-only data source.
KNOWFLOW_ANALYTICS_CATALOG_DATABASE_URL=postgresql+psycopg://analytics:change-me@127.0.0.1:5432/analytics_catalog
KNOWFLOW_ANALYTICS_DATASOURCE_DATABASE_URL=postgresql+psycopg://analytics_readonly:change-me@127.0.0.1:5432/customer_data

# Separate RAGFlow -> analytics credential. Generate at least 32 random characters.
KNOWFLOW_ANALYTICS_SERVICE_SECRET=replace-with-a-random-service-secret

# RAGFlow internal gateways. The token is the deployment's RAGFLOW_SECRET_KEY.
KNOWFLOW_ANALYTICS_RAGFLOW_BASE_URL=http://127.0.0.1:9380
KNOWFLOW_ANALYTICS_RAGFLOW_SERVICE_TOKEN=replace-with-ragflow-secret-key
KNOWFLOW_ANALYTICS_LLM_ID=replace-with-chat-model-id
KNOWFLOW_ANALYTICS_EMBEDDING_ID=replace-with-embedding-model-id
# Governed defaults: both LLM correctors are opt-in.
KNOWFLOW_ANALYTICS_S2SQL_CORRECTOR_ENABLED=false
KNOWFLOW_ANALYTICS_PHYSICAL_SQL_CORRECTOR_ENABLED=false
KNOWFLOW_ANALYTICS_MULTI_TURN_ENABLED=false
# off | shadow | auto. auto 只在单个 weak 指标短语上裁决，失败回退人工确认。
KNOWFLOW_ANALYTICS_WEAK_METRIC_ADJUDICATION_MODE=shadow

# Development only. Production uses versioned migrations in V1.
# 2026-08-22 added analytics_query_failures (refused questions, for offline vocabulary
# mining). Until migrations exist, a deployment that skips auto-create simply logs and
# drops those records; query responses are unaffected.
KNOWFLOW_ANALYTICS_AUTO_CREATE_SCHEMA=true
KNOWFLOW_ANALYTICS_ALLOW_DEBUG_SQL=false
KNOWFLOW_ANALYTICS_MINIMUM_EVALUATION_CASES=30
KNOWFLOW_ANALYTICS_MINIMUM_ACCURACY=1.0
